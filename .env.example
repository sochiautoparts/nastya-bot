# ════════════════════════════════════════════════════════════
#  Nastya Bot 38.0 — Environment Variables
#  Qwen3-4B (PRIMARY) + Qwen2.5-3B (SECONDARY)
#  llama-cpp-python с AVX2 + Pollinations fallback
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner ID (your Telegram user ID)
OWNER_ID=your_telegram_user_id

# ── LlamaCpp Model — DUAL MODEL ──────────────────────────
# PRIMARY: Qwen3-4B-Instruct — лучший русский, живые ответы
MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# SECONDARY: Qwen2.5-3B-Instruct — лёгкая быстрая резервная
MODEL2_PATH=models/Qwen2.5-3B-Instruct-Q4_K_M.gguf
# Какую модель использовать: qwen3=PRIMARY, qwen25=SECONDARY, auto=тест при старте
MODEL_PREFERENCE=qwen3
# Размер контекста (токенов) — 4096 для развёрнутых ответов
MODEL_N_CTX=4096
# Количество потоков CPU
MODEL_N_THREADS=4
# Максимум токенов в ответе Насти — 384 (баланс скорости и развёрнутости)
MODEL_MAX_TOKENS=384
# Сообщений в контексте (история беседы) — 15 для баланса памяти и скорости
MODEL_HISTORY_LIMIT=15

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
