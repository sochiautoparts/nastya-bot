# ════════════════════════════════════════════════════════════
#  Nastya Bot 36.0 — Environment Variables
#  llama-cpp-python (Qwen3-4B GGUF) + Pollinations fallback
#  НЕТ OLLAMA — модель загружается прямо в процесс!
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner ID (your Telegram user ID)
OWNER_ID=your_telegram_user_id

# ── LlamaCpp Model (PRIMARY!) ────────────────────────────
# Путь к GGUF модели — прямая загрузка в процесс
MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Размер контекста (токенов) — 2048 оптимально для CPU
MODEL_N_CTX=2048
# Количество потоков CPU (4 для вашего VPS)
MODEL_N_THREADS=4
# Максимум токенов в ответе Насти
MODEL_MAX_TOKENS=80

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
