# ════════════════════════════════════════════════════════════
#  Nastya Bot 26.0 — Environment Variables
#  Copy this file to .env and fill in your values
#  phi4-mini:3.8b (text) + moondream:2b (vision) + Pollinations fallback
#  NO QWEN — completely removed!
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner ID (your Telegram user ID)
OWNER_ID=your_telegram_user_id

# ── Ollama Local Models (PRIMARY!) ────────────────────────
# phi4-mini:3.8b for text (fast, smart)
# moondream:2b for vision (2-3x faster than qwen3-vl on CPU!)
# Pollinations as free fallback for text + vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_TIMEOUT=15

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
