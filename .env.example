# ════════════════════════════════════════════════════════════
#  Nastya Bot v70.0 — Environment Variables
#  RUADAPT QWEN3-4B-INSTRUCT + TESTED & OPTIMIZED + Local-First
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner ID (your Telegram user ID)
OWNER_ID=your_telegram_user_id

# Admin IDs (comma-separated, includes OWNER_ID by default)
ADMIN_IDS=your_telegram_user_id

# Bot username (without @)
BOT_USERNAME=asnastya_bot

# ── Pollinations.ai — PRIMARY AI Provider ─────────────────
POLLINATIONS_API_KEY=your_pollinations_api_key_here
POLLINATIONS_API_KEY_2=your_pollinations_api_key_2_here

# ── Cloudflare Workers AI — FALLBACK Provider ─────────────
# Mistral Small 3.1 (24B, vision) — 10k req/day per token
CF_ACCOUNT_ID_1=
CF_TOKEN_1=
CF_ACCOUNT_ID_2=
CF_TOKEN_2=
CF_DAILY_LIMIT=10000

# ── Local Model Toggle ───────────────────────────────────
# Set to "true" to enable RuadaptQwen3-4B-Instruct as local-first provider
# v70: Tested & optimized — temp=0.75, repeat_penalty=1.18, top_k=40
# RuadaptQwen3 = Russian tokenizer + Instruct (no <think> tags, confirmed) + Russian fine-tuning
# Default: true (local-first mode — saves cloud balance!)
ENABLE_LOCAL_MODEL=true

# ── LOCAL-ONLY POSTING ───────────────────────────────────
# When enabled, channel posts use ONLY the local model.
# Cloud APIs are saved for chat, consultations, vision.
LOCAL_ONLY_POSTING=true
LOCAL_POST_MAX_TOKENS=512

# ── LlamaCpp Model — LOCAL-FIRST RuadaptQwen3-4B-Instruct ────
# v70: RuadaptQwen3-4B-Instruct Q4_K_M — tested & optimized!
# Instruct version answers DIRECTLY — no thinking overhead, faster responses!
# Russian tokenizer: 48K extra Russian tokens → up to 2x faster Russian generation
# v12 optimizations: temp=0.75, rp=1.18, top_k=40, freq_penalty=0.3
# LOCAL_MODEL_SYSTEM_PROMPT — dedicated concise prompt for 4B model
MODEL_PATH=models/RuadaptQwen3-4B-Instruct-Q4_K_M.gguf
MODEL_N_CTX=4096
MODEL_N_THREADS=2
MODEL_MAX_TOKENS=1024
MODEL_HISTORY_LIMIT=6
MODEL_AUTO_DOWNLOAD=true
MODEL_DOWNLOAD_URL=https://huggingface.co/RefalMachine/RuadaptQwen3-4B-Instruct-GGUF/resolve/main/Q4_K_M.gguf

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT=
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
