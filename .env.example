# ════════════════════════════════════════════════════════════
#  Nastya Bot 15.0 — Environment Variables
#  Copy this file to .env and fill in your values
#  LOCAL Qwen3-VL-2B via Ollama + GitHub Models backup
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner ID (your Telegram user ID)
OWNER_ID=your_telegram_user_id

# ── Ollama Local Model (PRIMARY!) ─────────────────────────
# Qwen3-VL-2B running on localhost via Ollama
# Free, unlimited, no external API dependency, no SSE artifacts!
# Set up in GitHub Actions workflow (auto-installs Ollama + pulls model)
OLLAMA_BASE_URL=http://localhost:11434

# ── AI Providers (backups) ────────────────────────────────
# GitHub Models — reliable backup via PAT (DeepSeek-V3, GPT-4o-mini)
# Create fine-grained PAT with 'GitHub Models' permission:
# https://github.com/settings/tokens?type=beta
GH_MODELS_TOKEN=
GH_TOKEN_SECRET=
GITHUB_TOKEN=

# HuggingFace — optional, improves rate limits (works without key!)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Free cloud providers (no keys needed!):
# - Pollinations: always free, vision
# - Chutes: free DeepSeek V3, vision
# - Blackbox: free, unlimited, vision

# OpenRouter — DEMOTED (50 free req/day)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Additional providers (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
