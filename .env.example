# ════════════════════════════════════════════════════════════
#  Nastya Bot 14.0 — Environment Variables
#  Copy this file to .env and fill in your values
#  4 FREE UNLIMITED providers: Pollinations, Chutes, Blackbox, HuggingFace
#  v14.0: Apolitical — no politics, religion, war in posts or chat
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# ── AI Providers ─────────────────────────────────────────
# 4 FREE UNLIMITED providers (no API key needed!):
# - Pollinations: always free, always available, vision
# - Chutes: free DeepSeek V3, no key, vision
# - Blackbox: free, unlimited, multiple models, vision
# - HuggingFace: free tier (optional key), many models, vision
# These 4 providers work out of the box with ZERO configuration!

# OpenRouter — DEMOTED from PRIMARY (only 50 free req/day — too greedy!)
# Still useful as fallback for quality models
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# HuggingFace — optional, improves rate limits (works without key!)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# SECONDARY: Cloudflare Workers AI — free, reliable, vision
# Get token: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# TERTIARY: Groq — free, ultra-fast LPU inference
# Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Additional providers (optional)
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# GitHub Models (needs PAT with 'models' permission)
GH_MODELS_TOKEN=
GH_TOKEN_SECRET=
GITHUB_TOKEN=

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=-1003980256272
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
