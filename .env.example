# ════════════════════════════════════════════════════════════
#  Nastya Bot 45.0 — Environment Variables
#  Pollinations.ai PRIMARY + Local model (DISABLED by default)
# ════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────
# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Owner ID (your Telegram user ID)
OWNER_ID=your_telegram_user_id

# ── Pollinations.ai — PRIMARY AI Provider ─────────────────
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# ── Local Model Toggle ───────────────────────────────────
# Set to "true" to enable Qwen3-4B as local fallback
# Default: false (cloud-only mode — faster startup, less RAM)
ENABLE_LOCAL_MODEL=false

# ── LlamaCpp Model — LOCAL FALLBACK (only if enabled!) ────
MODEL_PATH=models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
MODEL_N_CTX=2048
MODEL_N_THREADS=4
MODEL_MAX_TOKENS=256
MODEL_HISTORY_LIMIT=10

# ── GitHub Actions (for 24/7 keep-alive) ─────────────────
GH_PAT_TOKEN=
GH_REPO=sochiautoparts/nastya-bot

# ── Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8081
DB_PATH=data/nastya.db
LOG_LEVEL=INFO

# ── Telegram Channel ─────────────────────────────────────
CHANNEL_ID=
CHANNEL_USERNAME=chasnastya

# ── News Settings ────────────────────────────────────────
NEWS_FETCH_INTERVAL=900
CHANNEL_POST_INTERVAL=1200
